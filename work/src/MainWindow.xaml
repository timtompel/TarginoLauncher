<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Central Arquivista" Width="1180" Height="720" WindowStartupLocation="CenterScreen" Foreground="White" FontFamily="Segoe UI">
  <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#48574C" Offset="0"/><GradientStop Color="#192226" Offset="0.65"/><GradientStop Color="#111719" Offset="1"/></LinearGradientBrush></Window.Background><Window.Resources>
    <Style x:Key="QuietThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#667B857E" CornerRadius="3" Margin="1"/></ControlTemplate></Setter.Value></Setter><Setter Property="Opacity" Value="0.65"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.Thumb><Thumb Style="{StaticResource QuietThumb}"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/></Trigger></Style.Triggers></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#168C34"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="15"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="Face" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#24AD44"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Background" Value="#24AD44"/><Setter TargetName="Face" Property="Effect"><Setter.Value><DropShadowEffect Color="#65E843" BlurRadius="14" ShadowDepth="0" Opacity="0.95"/></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="148"/><Setter Property="Height" Value="208"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border Name="Tile" Background="#343B40" BorderBrush="#555F63" BorderThickness="2"><Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><Image Source="{Binding [cover]}" Stretch="UniformToFill"/><Border Grid.Row="1" Background="#252D31" Padding="7"><TextBlock Text="{Binding [title]}" TextWrapping="Wrap" FontSize="12" Foreground="White"/></Border></Grid></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#65E843"/><Setter TargetName="Tile" Property="BorderThickness" Value="4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#65E843"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#303A3F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#607068"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#172520" Padding="22,16" BorderBrush="#526258" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="TarginoLauncher" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="Recompilados by Central Arquivista" Foreground="#9DB5A4" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
          <Button Name="ChooseRoot" Content="Escolher biblioteca" Margin="0,0,8,0"/>
          <Button Name="Reload" Content="Recarregar" Margin="0"/>
        </StackPanel>
        <Border Grid.Column="2" BorderBrush="#526258" BorderThickness="1,0,0,0" Padding="18,0,0,0">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Name="ClockTime" Foreground="White" FontSize="26" FontWeight="Light" HorizontalAlignment="Right"/>
            <TextBlock Name="ClockDate" Foreground="#CAD7CE" FontSize="12" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" LastChildFill="True"><TextBlock DockPanel.Dock="Top" Text="MINHA BIBLIOTECA" FontSize="13" Foreground="#D5E0D7" Margin="4,0,4,8"/><TextBox DockPanel.Dock="Top" Name="Search" Margin="4" Padding="8" FontSize="15"/><ListBox Name="Games" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DockPanel>
      <Border Grid.Column="1" Margin="18,0,0,0" Background="#D91B2428" Padding="20"><StackPanel><TextBlock Name="Title" Text="Biblioteca vazia" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Name="Meta" Margin="0,12,0,0" Foreground="#D5E0D7" FontSize="15"/><TextBlock Name="Description" Margin="0,24,0,0" FontSize="17" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Name="Play" Content="Jogar" FontSize="17" IsEnabled="False"/><Button Name="Details" Content="Detalhes" FontSize="17" IsEnabled="False"/></StackPanel><TextBlock Name="Status" Margin="0,30,0,0" Foreground="#D5E0D7" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
  </DockPanel>
</Window>
